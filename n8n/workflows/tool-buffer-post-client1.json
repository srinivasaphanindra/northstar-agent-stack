    {
      "id": "b4",
      "name": "Validate + build",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\n// Validate the request and build the Buffer GraphQL payloads. SAFE DEFAULTS: dry_run=true, mode=draft.\n// Publishing (mode queue/now) requires approved === true (set only after the client approved the post in Slack).\nconst i = $json;\nconst text = String(i.text || '').trim();\nconst service = String(i.service || '').toLowerCase().replace(/^x$/, 'twitter');\nconst mode = String(i.mode || 'draft').toLowerCase();\nconst dry = !(i.dry_run === false || i.dry_run === 'false');\nconst LIMITS = { twitter: 280, linkedin: 3000, facebook: 63206 };\nif (!text) throw new Error('text is required');\nif (!LIMITS[service]) throw new Error('service must be linkedin | twitter (x) | facebook');\nif (text.length > LIMITS[service]) throw new Error(`text is ${text.length} chars; ${service} limit is ${LIMITS[service]}`);\nif (!['draft', 'queue', 'now'].includes(mode)) throw new Error('mode must be draft | queue | now');\nif (mode !== 'draft' && !(i.approved === true || i.approved === 'true'))\n  throw new Error(`REFUSED: mode=${mode} publishes publicly and needs approved=true (client approval in Slack)`);\nconst input = { text, channelId: '__CHANNEL_ID__', schedulingType: 'automatic',\n  mode: mode === 'now' ? 'shareNow' : 'addToQueue', saveToDraft: mode === 'draft', aiAssisted: true, source: 'northstar-n8n' };\nif (i.media_url) input.assets = [{ image: { url: String(i.media_url) } }];\nconst createPost = {\n  query: `mutation CreatePost($input: CreatePostInput!) { createPost(input: $input) {\n    ... on PostActionSuccess { post { id status dueAt text } }\n    ... on MutationError { message } } }`,\n  variables: { input } };\nreturn [{ json: { service, mode, dry_run: dry, text_chars: text.length, createPost } }];\n"
      }
    },
