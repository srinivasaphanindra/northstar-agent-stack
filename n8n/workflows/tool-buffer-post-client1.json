      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.buffer.com",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: \"query($o: OrganizationId!) { channels(input: { organizationId: $o }) { id service name displayName isDisconnected isLocked } }\", variables: { o: $json.data.account.organizations[0].id } }) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "b9",
      "name": "Pick channel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst req = $('Validate + build').first().json;\nconst chans = ($json.data && $json.data.channels) || [];\nconst ch = chans.find(c => c.service === req.service && !c.isDisconnected && !c.isLocked);\nif (!ch) throw new Error(`No usable ${req.service} channel in Buffer (found: ${chans.map(c => c.service + ':' + c.name + (c.isDisconnected ? '(disconnected)' : '')).join(', ') || 'none'})`);\nconst body = JSON.parse(JSON.stringify(req.createPost));\nbody.variables.input.channelId = ch.id;\nreturn [{ json: { channel: { id: ch.id, name: ch.name, service: ch.service }, body } }];\n"
      }
    },
