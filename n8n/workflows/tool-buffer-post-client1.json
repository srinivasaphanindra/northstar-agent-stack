        "jsCode": "\nconst r = $json.data && $json.data.createPost;\nconst ch = $('Pick channel').first().json.channel;\nif (!r || r.message) throw new Error('Buffer createPost failed: ' + (r ? r.message : JSON.stringify($json.errors || $json)));\nreturn [{ json: { ok: true, channel: ch, post: r.post } }];\n"
      }
