        "jsCode": "\nconst b = $('Parse').first().json.body || {};\nif (!b.ts || $('Parse').first().json.dry) return [];\nreturn [{ json: { channel: b.channel || 'C0000000001', ts: b.ts, ok: !!$json.ok, note: $json.ok ? '' : 'Sorry, I could not post my answer (' + ($json.error || 'Slack error') + ').', thread_ts: b.thread_ts || b.ts } }];\n"
