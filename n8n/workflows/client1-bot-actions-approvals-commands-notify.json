    {
      "id": "a13",
      "name": "Build read-back",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\n// after the mutation: read the post back (status, dueAt, link). Deleted drafts: harmless account query.\nreturn $input.all().map((it, i) => {\n  const o = $('Buffer ops').all()[i].json;\n  const body = o.op === 'publish'\n    ? { query: 'query R($i: PostInput!) { post(input: $i) { id status dueAt sentAt externalLink } }', variables: { i: { id: o.post_id } } }\n    : { query: '{ account { id } }' };\n  return { json: { body } };\n});\n"
      }
    },
    {
      "id": "a14",
