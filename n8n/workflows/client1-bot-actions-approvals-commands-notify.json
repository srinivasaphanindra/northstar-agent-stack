    {
      "id": "a15",
      "name": "Collect results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst ops = $('Buffer ops').all().map(i => i.json);\nconst muts = $('Buffer: mutate').all().map(i => i.json);\nconst reads = $input.all().map(i => i.json);\nconst results = ops.map((o, i) => {\n  const m = muts[i] || {}, rd = reads[i] || {};\n  if (o.op === 'delete') {\n    const d = m.data && m.data.deletePost;\n    return { op: 'delete', service: o.service, post_id: o.post_id, ok: !!(d && d.id), error: d ? d.message : JSON.stringify(m.errors || m.error || m).slice(0, 200) };\n  }\n  const e = m.data && m.data.editPost;\n  const post = (rd.data && rd.data.post) || (e && e.post) || {};\n  const ok = !!(e && e.post);\n  return { op: 'publish', service: o.service, post_id: o.post_id, ok, status: post.status, dueAt: post.dueAt, externalLink: post.externalLink,\n           error: ok ? null : (e ? e.message : JSON.stringify(m.errors || m.error || m).slice(0, 200)) };\n});\nreturn [{ json: { body: { slack_ts: ops[0].slack_ts, results } } }];\n"
      }
