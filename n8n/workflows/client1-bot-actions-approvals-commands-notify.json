      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst t = $('When called').first().json;\nlet p = {}; try { p = typeof t.payload === 'string' ? JSON.parse(t.payload) : (t.payload || {}); } catch (e) { throw new Error('bad payload'); }\nconst dry = t.dry_run === true || t.dry_run === 'true';\nif (p.op === 'notify') {\n  const slack = { channel: p.channel || 'C0000000001', text: String(p.text || '').slice(0, 3900), unfurl_links: false, unfurl_media: false };\n  if (p.thread_ts) slack.thread_ts = p.thread_ts;\n  return [{ json: { kind: 'notify', dry, slack, ack: { ids: [p.id] } } }];\n}\nreturn [{ json: { kind: 'op', dry, body: { ...p, dry_run: dry } } }];\n"
      }
    },
