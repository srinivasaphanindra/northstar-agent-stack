        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\n// after 'pause everything': each queued Buffer post -> editPost saveToDraft:true; ok only if Buffer now says draft\nconst ops = $('Only hold ops').all().map(i => i.json);\nconst results = $input.all().map((it, i) => {\n  const e = it.json && it.json.data && it.json.data.editPost, st = e && e.post ? String(e.post.status || '') : '';\n  return { slack_ts: ops[i].slack_ts, post_id: ops[i].post_id, service: ops[i].service, ok: !!(e && e.post) && st.toLowerCase() === 'draft', status: st,\n           error: e && e.message ? e.message : (it.json.error ? String(it.json.error.message || it.json.error).slice(0, 200) : '') };\n});\nreturn [{ json: { body: { results } } }];\n"
