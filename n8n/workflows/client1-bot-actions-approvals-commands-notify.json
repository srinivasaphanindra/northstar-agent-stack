        "jsCode": "\n// ops that produced no reply: benign (already handled / not the approver / noop) -> ✅; real failure -> ⚠️ + note\nconst src = $('Parse').first().json, b = src.body || {};\nif (!b.ts || src.dry) return [];\nreturn $input.all().filter(i => i.json.kind === 'none').map(i => {\n  const e = String((i.json.info && (i.json.info.error || i.json.info.message)) || '');\n  const benign = !e || /already handled|not the approver|unknown op noop|state /.test(e);\n  return { json: { channel: b.channel || 'C0000000001', ts: b.ts, ok: benign, note: benign ? '' : 'Sorry, I could not process that (' + e.slice(0, 150) + '). Nothing was published or changed.', thread_ts: b.thread_ts || b.ts } };\n});\n"
