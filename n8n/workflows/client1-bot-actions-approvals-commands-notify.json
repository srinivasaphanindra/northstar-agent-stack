        "jsCode": "\n// helper /op (or /guard/verdict) answer -> content check (LLM), Buffer operations (publish/delete), Buffer holds, or a Slack reply\nconst r = $json, src = $('Parse').first().json;\nif (r && r.check) return [{ json: { kind: 'check', dry: src.dry, check: r.check } }];\nconst holds = (!src.dry && r && Array.isArray(r.hold_ops)) ? r.hold_ops.map(o => ({ json: { kind: 'hold', ...o } })) : [];\nif (!r || (!r.reply && !(Array.isArray(r.buffer_ops) && r.buffer_ops.length))) return [{ json: { kind: 'none', dry: src.dry, info: r } }, ...holds];\nconst ops = Array.isArray(r.buffer_ops) ? r.buffer_ops : [];\nif (ops.length) return ops.map(o => ({ json: { kind: 'buffer', dry: src.dry, slack_ts: src.body.slack_ts, thread_ts: r.thread_ts, ...o } }));\nconst thread = r.thread_ts || src.body.thread_ts || '';\nconst slack = { channel: src.body.channel || 'C0000000001', text: String(r.reply || ''), unfurl_links: false, unfurl_media: false };\nif (thread) slack.thread_ts = thread;\nreturn [{ json: { kind: 'reply', dry: src.dry, has_text: !!r.reply, run_drafter: !!r.run_drafter && !src.dry, run_coach: !!r.run_coach && !src.dry, slack,\n                  delete_ts: (!src.dry && r.delete_ts) ? r.delete_ts : '' } }, ...holds];\n"
      }
    },
