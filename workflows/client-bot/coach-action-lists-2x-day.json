      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst posted = $input.all().map(i => i.json), msgs = $('List messages').all().map(i => i.json);\nconst out = [];\nposted.forEach((p, i) => {\n  if (!p.ok || !msgs[i] || msgs[i].type !== 'task') return;\n  for (const name of ['white_check_mark', 'black_right_pointing_double_triangle_with_vertical_bar'])\n    out.push({ json: { body: { channel: p.channel, timestamp: p.ts, name } } });\n});\nreturn out.length ? out : [{ json: { body: null } }];\n"
      }
    },
