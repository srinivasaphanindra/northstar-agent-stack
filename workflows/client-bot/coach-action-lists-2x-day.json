    {
      "id": "c18",
      "name": "LLM prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst d = $('Collect posts').first().json, plan = d.plan || {};\nconst notes = String(($('Helper: notes').first().json || {}).notes || '').slice(0, 1500);\nconst handle = (plan.handles && plan.handles.x) || 'your_x_handle';\nconst left = (plan.left || {}).x || {};\nconst posts = (d.posts || []).map(p => ({ url: p.url, handle: p.handle, text: String(p.text || '').slice(0, 400), age: p.age, replies: p.replies, likes: p.likes }));\nconst n = Math.max(1, Math.min(8, (left.replies || 0) + (left.quotes || 0), plan.size || 8));\nconst prompt = `You build a short \"action list\" of MANUAL tasks for the owner of the X account @${handle}. He does every task by hand in the app; nothing is automated.\nClient notes (voice, offer, things to avoid):\n${notes || '(none)'}\n\nTopic today: ${plan.topic}\nFresh X posts from a read-only search (JSON):\n${JSON.stringify(posts)}\n\nPick up to ${n} posts worth acting on NOW and give each exactly ONE kind:\n- \"reply_trend\": a fresh (under about 2h), busy post in the niche: reply with something specific.\n- \"creator_comment\": a post by a known creator from the last hour: an early, thoughtful reply.\n- \"quote\": at most 1, a strong post worth quoting with the client's own short take.\n- \"join_thread\": at most 1, a post with a live conversation (many replies): add a useful reply.\nSkip politics, religion, tragedies, controversy, crypto, giveaways, engagement bait, ads, sales pitches, anything off-topic or older than 6h.\nAt most one post per author.\nFor each pick write 2 DIFFERENT drafts in the client's voice: replies under 200 characters, quotes under 260; 1-2 short sentences; lowercase is fine;\nmention one concrete detail from the post; include a real question, or a small tip or personal experience.\nNever: links, hashtags, @mentions, emojis, em dashes, pitching, products or services, \"DM me\", generic praise (\"great post\"), invented numbers or results.\nAlso write 2 ready-to-adapt comment drafts for fresh LinkedIn posts about the topic (li_angles) and 2 for Facebook posts (fb_angles): same rules, each with a real question.\nReturn ONLY JSON, no prose:\n{\"tasks\":[{\"kind\":\"reply_trend|creator_comment|quote|join_thread\",\"url\":\"<exact url from the list>\",\"drafts\":[\"...\",\"...\"],\"why\":\"max 12 words\"}],\"li_angles\":[\"...\",\"...\"],\"fb_angles\":[\"...\",\"...\"]}`;\nreturn [{ json: { prompt } }];\n"
      }
    },
