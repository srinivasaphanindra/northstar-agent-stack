    {
      "id": "c10",
      "name": "Collect posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1620,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\n// Gather posts from the read-only browser runs (or the fake posts). A warning / captcha / login page -> pause + report.\nconst st = $('Start').first().json, items = $input.all().map(i => i.json);\nconst plan = $('Helper: coach plan').first().json;\nlet posts = Array.isArray(st.posts) ? st.posts : [], danger = '';\nfor (const r of items) {\n  if (r.stop) return [{ json: r }];\n  if (r.read === false) continue;\n  const txt = String(r.result_text || (r.error && (r.error.message || r.error)) || '');\n  if (r.status === 'stopped' && !/read-only mode: refused/i.test(txt)) { danger = txt.slice(0, 400); break; }\n  const m = txt.match(/\\[[\\s\\S]*\\]/);\n  if (m) { try { const a = JSON.parse(m[0]); if (Array.isArray(a)) posts = posts.concat(a.slice(0, 12)); } catch (e) {} }\n}\nreturn [{ json: { danger: !!danger, reason: danger, posts: posts.slice(0, 20), plan, dry_run: st.dry_run } }];\n"
      }
    },
