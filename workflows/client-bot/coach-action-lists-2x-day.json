    },
    {
      "id": "c7",
      "name": "Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1020,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\n// Not running (not Viral, quiet hours, paused, budget): stop quietly (dry runs return the reason).\nconst p = $json || {}, st = $('Start').first().json;\nif (!p.ok_to_run) return st.dry_run ? [{ json: { stop: true, dry_run: true, why_not: p.why_not || 'helper down', plan: p.plan_label } }] : [];\nconst handle = (p.handles && p.handles.x) || 'your_x_handle';\nif (Array.isArray(st.posts)) return [{ json: { read: false, plan: p } }];          // fake posts (tests): no browser\nif (!(p.search_urls || []).length) return [{ json: { read: false, plan: p } }];    // nothing to read (budget used, or browser cap)\nreturn p.search_urls.map(u => ({ json: { read: true, plan: p, kind: u.kind, task: `Open ${u.url} . READ-ONLY light task on X (manual action-list only; logged in as @${handle}; do not like, reply, follow, repost or click any button).\nWait for posts to load. Extract the first 6 posts only (no second scroll).\nFor each: url (https://x.com/<handle>/status/<id>), handle, text (short), age. Skip ads. Call done with ONLY a JSON array.` } }));\n"
      }
    },
