      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\n// helper returns [header, task, task, ...]; dry run -> return them as the result, never post\nconst r = $json || {}, st = $('Start').first().json;\nif (st.dry_run) return [{ json: { dry_run: true, n_tasks: r.n_tasks || 0, why_not: r.why_not || '', dropped: r.dropped || [], list_id: r.list_id || '',\n  preview: (r.messages || []).map(m => m.slack.text) } }];\nif (!r.ok || !(r.messages || []).length) return [];\nreturn r.messages.map(m => ({ json: { type: m.type, task_id: m.task_id || null, list_id: r.list_id, slack: m.slack } }));\n"
