    {
      "id": "c29",
      "name": "Register body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4220,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst posted = $('Slack: post list').all().map(i => i.json), msgs = $('List messages').all().map(i => i.json);\nconst tasks = []; let header_ts = '';\nposted.forEach((p, i) => {\n  const m = msgs[i]; if (!m || !p.ok) return;\n  if (m.type === 'header') header_ts = p.ts; else tasks.push({ task_id: m.task_id, slack_ts: p.ts });\n});\nreturn [{ json: { body: { list_id: msgs[0] ? msgs[0].list_id : '', header_ts, tasks } } }];\n"
