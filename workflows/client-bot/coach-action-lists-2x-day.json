    {
      "id": "c5",
      "name": "Start",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        620,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\n// Inputs: dry_run, slot ('am' | 'pm' | 'extra'), force_plan (dry runs only), posts_json (fake posts for tests: skips the browser read)\nconst j = $input.first().json || {};\nconst b = j.body || j;\nconst dry = b.dry_run === true || b.dry_run === 'true';\nlet posts = null;\ntry { if (b.posts_json) posts = JSON.parse(b.posts_json); } catch (e) { posts = null; }\nif (Array.isArray(b.posts)) posts = b.posts;\nconst body = { dry_run: dry, slot: b.slot || '', force_plan: dry ? (b.force_plan || '') : '', posts: posts || undefined,\n               ignore_quiet: dry && (b.ignore_quiet === true || b.ignore_quiet === 'true') };\nif (dry && b.now) body.now = Number(b.now);\nreturn [{ json: { body, dry_run: dry, posts, source: j.source || (j.body ? 'webhook' : 'subworkflow') } }];\n"
      }
    },
    {
      "id": "c6",
      "name": "Helper: coach plan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueRegularOutput",
      "position": [
        820,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8771/coach/plan",
        "options": {
          "timeout": 20000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}"
