    {
      "id": "e19",
      "name": "Parse + validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2620,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst raw = String($json.text || $json.output || '');\nlet arr = []; const m = raw.match(/\\[[\\s\\S]*\\]/);\nif (m) { try { arr = JSON.parse(m[0]); } catch (e) { arr = []; } }\nconst posts = $('Helper: filter seen posts').first().json.posts || [];\nconst byUrl = Object.fromEntries(posts.map(p => [String(p.url).split('?')[0], p]));\nconst items = [];\nfor (const s of (Array.isArray(arr) ? arr : [])) {\n  const url = String(s.url || '').split('?')[0], p = byUrl[url];\n  const action = String(s.action || '').toLowerCase();\n  const acts = ($('Gate').first().json.plan || {}).allowed_actions || ['reply', 'repost'];\n  if (!p || !acts.includes(action)) continue;\n  const text = action === 'reply' ? String(s.text || '').replace(/\\s+/g, ' ').trim() : '';\n  if (action === 'reply' && (!text || text.length >= 200)) continue;\n  items.push({ url, handle: String(p.handle || '').replace(/^@+/, ''), post_text: String(p.text || ''), age: p.age || '', action, text, why: String(s.why || '').slice(0, 120) });\n}\nif (items.filter(i => i.action === 'repost').length > 1) { let seen = false; for (let i = items.length - 1; i >= 0; i--) if (items[i].action === 'repost') { if (seen) items.splice(i, 1); else seen = true; } }\nreturn [{ json: { body: { items: items.slice(0, 3) } } }];\n"
      }
    },
