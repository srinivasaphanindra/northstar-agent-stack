      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst r = $json || {}, g = $('Gate').first().json;\nconst txt = String(r.result_text || (r.error && (r.error.message || r.error)) || '');\nconst status = r.status || 'error';\nif (status === 'stopped' && !/read-only mode: refused/i.test(txt)) {\n  return [{ json: { danger: true, reason: txt.slice(0, 400), status, dry_run: g.dry_run } }];\n}\nlet posts = [];\nconst m = txt.match(/\\[[\\s\\S]*\\]/);\nif (m) { try { posts = JSON.parse(m[0]); } catch (e) { posts = []; } }\nreturn [{ json: { danger: false, status, browser_id: r.id, posts: Array.isArray(posts) ? posts.slice(0, 10) : [], raw: posts.length ? '' : txt.slice(0, 500), dry_run: g.dry_run } }];\n"
      }
