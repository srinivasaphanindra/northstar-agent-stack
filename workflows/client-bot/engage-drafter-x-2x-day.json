      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst items = ($json.items || []).filter(i => i.action !== 'reply' || (i.lint || []).length === 0).slice(0, 3);\nconst dry = $('Gate').first().json.dry_run;\nconst topic = $('Gate').first().json.plan.topic;\nconst LABEL = { reply: 'Reply', like: 'Like', repost: 'Repost' };\nreturn items.map((s, k) => {\n  const excerpt = s.post_text.replace(/\\s+/g, ' ').slice(0, 220) + (s.post_text.length > 220 ? '…' : '');\n  const text = `*X engagement idea ${k + 1}/${items.length}* for @your_x_handle (topic: ${topic})\\n`\n    + `*Post:* <${s.url}|@${s.handle}>${s.age ? ' (' + s.age + ')' : ''}\\n> ${excerpt}\\n`\n    + `*Proposed action:* ${LABEL[s.action]}${s.action === 'reply' ? '\\n> ' + s.text : ''}\\n`\n    + (s.why ? `_Why:_ ${s.why}\\n` : '')\n    + `React ✅ to do exactly this once, ❌ to skip. (Max ${$('Gate').first().json.plan.cap} actions a day, ${$('Gate').first().json.plan.min_gap_minutes || 7}+ min apart. Say 'pause engagement' to stop everything.)`;\n  return { json: { dry, suggestion: { action: s.action, url: s.url, handle: s.handle, text: s.text, topic },\n                   slack: { channel: 'C0000000001', text, unfurl_links: false, unfurl_media: false } } };\n});\n"
