        "jsCode": "\nconst sug = $('Suggestion messages').all().map(i => i.json);\nconst out = [];\n$input.all().forEach((it, i) => {\n  if (!it.json.ok) return;\n  for (const name of ['white_check_mark', 'x']) out.push({ json: { body: { channel: it.json.channel, timestamp: it.json.ts, name } } });\n});\nreturn out;\n"
