      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst p = $json, st = $('Start').first().json;\nif (!p || !p.ok_to_run) return [];          // paused (kill switch) or helper down -> do nothing, no LLM\nconst kind = p.read_type || 'x_following';\nconst where = kind === 'x_watch' ? 'watchlist search (from:handles only — not a keyword/topic search)' : 'Following / Home timeline (accounts you follow)';\nconst task = `Open ${p.search_url} . READ-ONLY task on X ${where} (logged in as @your_x_handle; do not like, reply, follow, repost or click any button).\nWait for the posts to load. Use the extract action once to read the first 8 posts (scroll down once only if fewer than 6 are visible).\nFor each post get: url (its permalink https://x.com/<handle>/status/<id>, from the post's timestamp link), handle, name, text (full post text), age (e.g. 3h, 1d), replies, likes.\nSkip promoted/ad posts. Then call done with ONLY a JSON array of these posts and nothing else.`;\nreturn [{ json: { task, plan: p, dry_run: st.dry_run } }];\n"
      }
