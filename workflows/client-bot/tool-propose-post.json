      "name": "Replaced drafts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\n// Old drafts replaced after an ✏️ edit are deleted in Buffer (or a harmless read if none).\nconst rep = ($json.replaced || []).flatMap(r => r.drafts || []);\nif (!rep.length) return [{ json: { body: { query: '{ account { id } }' } } }];\nreturn rep.map(d => ({ json: { body: { query: 'mutation D($input: DeletePostInput!) { deletePost(input: $input) { ... on DeletePostSuccess { id } ... on VoidMutationError { message } } }', variables: { input: { id: d.post_id } } } } }));\n"
      }
    },
