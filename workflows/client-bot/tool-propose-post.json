        100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.buffer.com",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      }
    },
    {
      "id": "q14",
      "name": "Tool result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst c = $('Collect drafts').first().json;\nconst ts = $('Slack: preview').first().json.ts;\nconst rep = ($('Helper: register proposal').first().json.replaced || []).flatMap(r => r.drafts || []);\nreturn [{ json: { ok: true, preview_posted: true, preview_ts: ts, drafts: c.drafts, failed: c.failed, when: c.when,\n  replaced_drafts_deleted: rep.map(d => d.post_id),\n  note: 'Preview with draft ids is in the thread. Waiting for the owner: ✅ publish, ✏️ edit, ❌ discard. Do not repeat the text.' } }];\n"
      }
    }
