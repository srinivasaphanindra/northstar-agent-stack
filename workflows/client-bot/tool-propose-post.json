      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst t = $('When called by agent').first().json;\nconst text = String(t.text || '').trim();\nif (!text) throw new Error('text is required');\nconst map = { x: 'x', twitter: 'x', linkedin: 'linkedin', li: 'linkedin', facebook: 'facebook', fb: 'facebook' };\nconst services = [...new Set(String(t.services || 'x').toLowerCase().split(/[\\s,;+&]+|and/).map(s => map[s.trim()]).filter(Boolean))];\nif (!services.length) throw new Error('services must list x, linkedin and/or facebook');\nreturn services.map(service => ({ json: { text, service, dry_run: t.dry_run === true || t.dry_run === 'true' } }));\n"
      }
