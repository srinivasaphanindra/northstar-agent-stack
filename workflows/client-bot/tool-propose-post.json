        "jsCode": "\nconst c = $('Collect drafts').first().json;\nif (!$json.ok) throw new Error('Slack preview failed: ' + ($json.error || 'unknown'));\nreturn ['white_check_mark', 'pencil2', 'x'].map(name => ({ json: { body: { channel: $json.channel, timestamp: $json.ts, name }, preview_ts: $json.ts } }));\n"
