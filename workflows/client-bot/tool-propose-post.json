    {
      "id": "q4",
      "name": "Collect drafts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst t = $('When called by agent').first().json;\nconst reqs = $('Split per service').all().map(i => i.json);\nconst NAMES = { x: 'X @your_x_handle', linkedin: 'LinkedIn your-linkedin-handle', facebook: 'Facebook Page YourBrand' };\nconst res = $input.all().map((it, i) => {\n  const j = it.json, svc = reqs[i].service;\n  if (j.dry_run) return { service: svc, ok: true, dry: true };\n  if (j.ok && j.post && j.post.id) return { service: svc, ok: true, post_id: j.post.id, channel_id: j.channel && j.channel.id };\n  return { service: svc, ok: false, error: String((j.error && (j.error.message || j.error)) || JSON.stringify(j)).slice(0, 200) };\n});\nconst drafts = res.filter(r => r.ok && r.post_id).map(r => ({ service: r.service === 'x' ? 'twitter' : r.service, post_id: r.post_id, channel_id: r.channel_id }));\nconst failed = res.filter(r => !r.ok);\nconst when = String(t.when || 'queue').toLowerCase() === 'now' ? 'now' : 'queue';\nconst dry = t.dry_run === true || t.dry_run === 'true';\nconst quote = String(t.text).split('\\n').map(l => '> ' + l).join('\\n');\nconst okNames = res.filter(r => r.ok).map(r => NAMES[r.service]).join(' + ');\nconst text = `*${t.label ? String(t.label).slice(0, 60) + ' · post preview' : 'Post preview'}* for ${okNames} (${when === 'now' ? 'share NOW on ✅' : 'add to Buffer queue on ✅'})\\n${quote}\\n`\n  + `Buffer draft id(s): ${drafts.map(d => `${d.service === 'twitter' ? 'X' : d.service} \\`${d.post_id}\\``).join(', ') || '(dry run)'}`\n  + (failed.length ? `\\nNot drafted: ${failed.map(f => f.service + ' (' + f.error + ')').join('; ')}` : '')\n  + `\\nReact ✅ publish · ✏️ edit · ❌ discard (deletes the draft). Or reply 'approve' / 'post it' / 'post it now'.`;\nreturn [{ json: { dry, when, drafts, failed, preview_ok: !dry && drafts.length > 0,\n  slack: { channel: t.channel || 'C0000000001', thread_ts: t.thread_ts || undefined, text, unfurl_links: false, unfurl_media: false } } }];\n"
      }
