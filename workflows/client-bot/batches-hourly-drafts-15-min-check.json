      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\n// browser results (or fakes) -> reads for /batch/pick (the helper handles warning pages: platform pause / engagement pause)\nconst st = $('Start').first().json, plan = $('Helper: batch plan').first().json;\nconst gate = $('Gate').all().map(i => i.json), res = $input.all().map(i => i.json);\nconst reads = [];\ngate.forEach((g, i) => {\n  if (g.none || !g.spec) return;\n  const r = g.read ? (res[i] || {}) : null;\n  if (!g.read) {\n    if (g.spec.type === 'x_search' || g.spec.type === 'x_watch' || g.spec.type === 'x_following') reads.push({ ...g.spec, status: 'ok', posts: st.posts || [] });\n    else reads.push({ ...g.spec, status: (st.targets || {})[g.spec.url] ? 'ok' : 'error', data: (st.targets || {})[g.spec.url] || {} });\n    return;\n  }\n  reads.push({ ...g.spec, status: r.status || 'error', result_text: String(r.result_text || (r.error && (r.error.message || r.error)) || '').slice(0, 6000) });\n});\nreturn [{ json: { body: { ...st.body, alloc: plan.alloc, reads, batch_id: plan.batch_id } } }];\n"
      }
