        "jsCode": "\nconst r = $('Helper: batch build').first().json, hts = $('Slack: batch header').first().json.ts;\nlet posted = []; try { posted = $('Slack: batch item').all().map(i => i.json); } catch (e) { posted = []; }\nlet thread = []; try { thread = $('Thread items').all().map(i => i.json).filter(i => !i.skip); } catch (e) { thread = []; }\nconst items = (r.items || []).map(it => {\n  const k = thread.findIndex(x => x.n === it.n), p = k >= 0 ? posted[k] : null;\n  return { n: it.n, payload: it.payload, slack_ts: p && p.ok ? p.ts : '' };\n});\nlet props = []; try { props = $('Propose batch post').all().map(i => i.json); } catch (e) { props = []; }\nconst posts = (r.posts || []).map((po, i) => ({ n: po.n, preview_ts: (props[i] && props[i].preview_ts) || '' }));\nreturn [{ json: { body: { batch_id: r.batch_id, header_ts: hts, items, posts } } }];\n"
