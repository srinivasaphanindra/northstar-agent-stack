        "jsCode": "\n// header posted -> thread items (replies / comments). Posts are created by the propose-post tool further down.\nconst h = $json || {}, r = $('Helper: batch build').first().json;\nif (!h.ok || !h.ts) throw new Error('Slack header failed: ' + (h.error || 'unknown'));\nconst items = (r.items || []).map(i => ({ json: { n: i.n, header_ts: h.ts, slack: { ...i.slack, thread_ts: h.ts } } }));\nreturn items.length ? items : [{ json: { skip: true, header_ts: h.ts } }];\n"
