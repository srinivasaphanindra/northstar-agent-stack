      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\n// Inputs: dry_run, force_plan (dry only), now (dry only), ignore_timing (dry only), posts_json (fake X search posts),\n// targets_json (fake text of client-chosen LinkedIn/Facebook posts), raw (fake LLM drafts JSON: skips the LLM). Schedule: all empty.\nconst j = $input.first().json || {};\nconst b = j.body || j;\nconst dry = b.dry_run === true || b.dry_run === 'true';\nconst J = s => { try { return s ? JSON.parse(s) : null; } catch (e) { return null; } };\nconst posts = dry ? (Array.isArray(b.posts) ? b.posts : J(b.posts_json)) : null;\nconst targets = dry ? (b.targets && typeof b.targets === 'object' ? b.targets : J(b.targets_json)) : null;\nconst raw = dry ? String(b.raw || '') : '';\nconst body = { dry_run: dry, force_plan: dry ? (b.force_plan || '') : '', ignore_timing: dry && (b.ignore_timing === true || b.ignore_timing === 'true') };\nif (dry && Number(b.now)) body.now = Number(b.now);\nreturn [{ json: { body, dry_run: dry, posts, targets, raw, fake: !!(posts || targets) } }];\n"
      }
