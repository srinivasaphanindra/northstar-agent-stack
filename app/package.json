{
  "name": "northstar-app",
  "version": "0.2.0",
  "private": true,
  "description": "Northstar Agents - agent-as-a-service platform (phase 1)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p ${PORT:-3100}",
    "build": "prisma generate && next build",
    "start": "next start -H ${HOST:-127.0.0.1} -p ${PORT:-3100}",
    "worker": "tsx --env-file-if-exists=.env worker/index.ts",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:pg-schema": "node scripts/make-postgres-schema.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "screens": "node scripts/screenshots.mjs",
    "slack:live-check": "tsx --env-file-if-exists=.env scripts/slack-live-check.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "15.5.27",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "tsx": "4.20.6",
    "yaml": "2.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.8",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "playwright-core": "1.56.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
